generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DecisionStatus {
  APPROVED
  PENDING
  REJECTED
}

enum UserRole {
  ADMIN
  MAINTAINER
  REVIEWER
  VIEWER
}

enum DecisionAuditAction {
  CREATED
  EDITED
  APPROVED
  REJECTED
  REOPENED
  CONTEXT_LINKED
  RELATIONSHIP_SUGGESTED
  RELATIONSHIP_ACCEPTED
  RELATIONSHIP_DISMISSED
  RELATIONSHIP_STALE
}

enum DecisionExtractionMethod {
  UNKNOWN
  OLLAMA
  STRUCTURED_FALLBACK
}

enum ContextProvider {
  GITHUB
  LINEAR
  JIRA
  GENERIC
}

enum ExternalContextType {
  ISSUE
  ADR
  ARCHITECTURE_DOC
  MEETING
}

enum ExternalContextStatus {
  ACTIVE
  UNAVAILABLE
}

enum DecisionContextRelationshipType {
  RELATED
  ORIGINATED_FROM
  DOCUMENTS
  DISCUSSED_IN
}

enum ProviderConnectionStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

enum WebhookEventStatus {
  RECEIVED
  QUEUED
  PROCESSED
  FAILED
}

enum ContextSyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  UNAVAILABLE
}

enum DecisionRelationshipType {
  RELATED
  BUILDS_ON
  SUPERSEDES
  POSSIBLE_CONFLICT
}

enum DecisionRelationshipStatus {
  SUGGESTED
  ACCEPTED
  DISMISSED
  STALE
}

enum DecisionRelationshipAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model AppUser {
  id                String              @id @default(cuid())
  githubId          String              @unique
  login             String              @unique
  name              String?
  avatarUrl         String?
  role              UserRole            @default(VIEWER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedDecisions DecisionMemory[]    @relation("ApprovedDecisionUser")
  rejectedDecisions DecisionMemory[]    @relation("RejectedDecisionUser")
  editedDecisions   DecisionMemory[]    @relation("EditedDecisionUser")
  auditLogs         DecisionAuditLog[]
  createdContextLinks DecisionContextLink[]
  providerConnections ProviderConnection[]
  reviewedRelationships DecisionRelationship[]

  @@index([role])
  @@map("app_users")
}

model PullRequestRecord {
  id            String           @id @default(cuid())
  prNumber      Int
  title         String
  description   String?
  mergedAt      DateTime?
  author        String
  url           String
  repository    String
  sourcePayload Json?
  createdAt     DateTime         @default(now())
  decisions     DecisionMemory[]

  @@unique([repository, prNumber])
  @@index([repository, createdAt])
  @@map("pr_records")
}

model DecisionMemory {
  id          String            @id @default(cuid())
  decision    String
  reason      String
  alternative String?
  impact      String
  author      String
  sourcePR    String
  repository  String
  filesChanged String[]         @default([])
  confidence  Float
  status      DecisionStatus    @default(PENDING)
  category    String            @default("architecture")
  extractionMethod DecisionExtractionMethod @default(UNKNOWN)
  prRecordId  String?
  prRecord    PullRequestRecord? @relation(fields: [prRecordId], references: [id], onDelete: SetNull)
  approvedByUserId String?
  approvedBy       AppUser?      @relation("ApprovedDecisionUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedByLogin  String?
  approvedAt       DateTime?
  rejectedByUserId String?
  rejectedBy       AppUser?      @relation("RejectedDecisionUser", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  rejectedByLogin  String?
  rejectedAt       DateTime?
  lastEditedByUserId String?
  lastEditedBy       AppUser?    @relation("EditedDecisionUser", fields: [lastEditedByUserId], references: [id], onDelete: SetNull)
  lastEditedByLogin  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  auditLogs   DecisionAuditLog[]
  contextLinks DecisionContextLink[]
  outgoingRelationships DecisionRelationship[]        @relation("DecisionRelationshipSource")
  incomingRelationships DecisionRelationship[]        @relation("DecisionRelationshipTarget")
  relationshipAnalysis  DecisionRelationshipAnalysis?

  @@index([status])
  @@index([repository])
  @@index([category])
  @@index([createdAt])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
  @@index([lastEditedByUserId])
  @@map("decision_memories")
}

model DecisionAuditLog {
  id         String              @id @default(cuid())
  decisionId String
  decision   DecisionMemory      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  action     DecisionAuditAction
  actorUserId String?
  actor       AppUser?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorLogin  String?
  note        String?
  before      Json?
  after       Json?
  createdAt   DateTime           @default(now())

  @@index([decisionId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("decision_audit_logs")
}

model ExternalContext {
  id                String                @id @default(cuid())
  provider          ContextProvider
  type              ExternalContextType
  providerAccountId String                @default("global")
  externalId        String
  url               String
  normalizedUrl     String
  title             String?
  description       String?
  status            ExternalContextStatus @default(ACTIVE)
  metadata          Json?
  lastSyncedAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  decisionLinks     DecisionContextLink[]
  syncState         ContextSync?

  @@unique([provider, providerAccountId, externalId])
  @@index([provider, type])
  @@index([status])
  @@index([normalizedUrl])
  @@map("external_contexts")
}

model DecisionContextLink {
  id                String                          @id @default(cuid())
  decisionId        String
  decision          DecisionMemory                  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  externalContextId String
  externalContext   ExternalContext                 @relation(fields: [externalContextId], references: [id], onDelete: Restrict)
  relationshipType  DecisionContextRelationshipType @default(RELATED)
  createdByUserId   String?
  createdBy         AppUser?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByLogin    String?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  @@unique([decisionId, externalContextId])
  @@index([externalContextId])
  @@index([createdByUserId])
  @@index([relationshipType])
  @@map("decision_context_links")
}

model ProviderConnection {
  id                    String                   @id @default(cuid())
  provider              ContextProvider
  providerAccountId     String                   @default("global")
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  scopes                String[]                 @default([])
  status                ProviderConnectionStatus @default(ACTIVE)
  metadata              Json?
  createdByUserId       String?
  createdBy             AppUser?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([provider, providerAccountId])
  @@index([status])
  @@index([createdByUserId])
  @@map("provider_connections")
}

model WebhookEvent {
  id                 String             @id @default(cuid())
  provider           ContextProvider
  externalDeliveryId String
  eventType          String
  payload            Json
  status             WebhookEventStatus @default(RECEIVED)
  attempts           Int                @default(0)
  receivedAt         DateTime           @default(now())
  processedAt        DateTime?
  lastError          String?

  @@unique([provider, externalDeliveryId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model ContextSync {
  id            String            @id @default(cuid())
  contextId     String            @unique
  context       ExternalContext   @relation(fields: [contextId], references: [id], onDelete: Cascade)
  status        ContextSyncStatus @default(PENDING)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  error         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@map("context_syncs")
}

model DecisionRelationship {
  id               String                     @id @default(cuid())
  sourceDecisionId String
  sourceDecision   DecisionMemory             @relation("DecisionRelationshipSource", fields: [sourceDecisionId], references: [id], onDelete: Cascade)
  targetDecisionId String
  targetDecision   DecisionMemory             @relation("DecisionRelationshipTarget", fields: [targetDecisionId], references: [id], onDelete: Cascade)
  type             DecisionRelationshipType
  status           DecisionRelationshipStatus @default(SUGGESTED)
  confidence       Float
  explanation      String
  evidence         String[]                   @default([])
  analysisVersion  String
  reviewedByUserId String?
  reviewedBy       AppUser?                   @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedByLogin  String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([sourceDecisionId, targetDecisionId])
  @@index([targetDecisionId])
  @@index([status])
  @@index([type])
  @@index([reviewedByUserId])
  @@map("decision_relationships")
}

model DecisionRelationshipAnalysis {
  id               String                             @id @default(cuid())
  decisionId       String                             @unique
  decision         DecisionMemory                     @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  status           DecisionRelationshipAnalysisStatus @default(PENDING)
  analysisVersion  String
  candidateCount   Int                                @default(0)
  suggestionCount  Int                                @default(0)
  requestedByLogin String?
  lastAttemptAt    DateTime?
  lastSuccessAt    DateTime?
  error            String?
  createdAt        DateTime                           @default(now())
  updatedAt        DateTime                           @updatedAt

  @@index([status])
  @@map("decision_relationship_analyses")
}
